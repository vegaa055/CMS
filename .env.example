# Copy to .env.local and fill in values.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Postgres (Phase 1)
DATABASE_URL=

# Better Auth (Phase 2) — generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
# The first account to register becomes admin; after that sign-up is closed unless this is true.
AUTH_ALLOW_SIGNUP=false
# Optional GitHub OAuth (callback: <APP_URL>/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudflare R2 (Phase 5)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
